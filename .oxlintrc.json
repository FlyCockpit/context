{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "off"
  },
  "rules": {},
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/dev-dist/",
    "**/build/",
    "**/coverage/",
