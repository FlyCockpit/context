{
  "name": "cockpit-context",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:raw": "turbo dev",
    "build": "turbo build",
    "test": "turbo run test",
    "check-types": "turbo check-types && pnpm check-types:scripts",
    "check-types:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "biome lint . && pnpm policy:prisma-query-casts && pnpm lint:design",
    "lint:design": "oxlint",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm policy:prisma-query-casts",
    "check:ci": "biome check . && pnpm policy:prisma-query-casts && pnpm policy:prisma-query-casts:test && pnpm lint:design",
    "verify": "pnpm check:ci && pnpm policy:checks && pnpm policy:template-secrets && pnpm policy:local-db-guard && pnpm policy:agents-size && pnpm policy:test-colocation && pnpm policy:access-matrix && pnpm policy:theme-contrast && pnpm check-types && pnpm test && pnpm test:setup && pnpm test:dev-tools && pnpm knip && pnpm env:check && pnpm env:check-entrypoints && pnpm docker:check-copy && pnpm docs:check-citations && pnpm deps:check-excludes && pnpm db:test-unit && pnpm backup:test-unit && pnpm deploy:test-unit",
    "verify:fast": "pnpm biome check . && pnpm deps:check-excludes && pnpm policy:prisma-query-casts && pnpm lint:design && pnpm policy:agents-size && pnpm policy:test-colocation && pnpm policy:access-matrix && pnpm policy:theme-contrast && pnpm docs:check-citations && pnpm env:check && pnpm policy:checks && pnpm turbo check-types --affected --output-logs=errors-only && pnpm check-types:scripts && pnpm turbo run test --affected --output-logs=errors-only && pnpm test:setup && pnpm test:dev-tools && pnpm db:test-unit && pnpm backup:test-unit && pnpm deploy:test-unit",
    "verify:tooling": "pnpm policy:checks:self-test && pnpm policy:hooks && pnpm policy:trufflehog-filter && pnpm policy:access-matrix:self-test && pnpm dokploy:test",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:seed": "turbo -F @cockpit-context/db db:seed",
    "db:studio": "turbo -F @cockpit-context/db db:studio",
    "runtime:test-operations": "node scripts/test-runtime-operations.mjs --disposable-services",
    "dokploy:verify": "node scripts/verify-dokploy-deployment.mjs",
    "dokploy:test": "node scripts/test-dokploy-deployment.mjs",
    "db:generate": "turbo -F @cockpit-context/db db:generate",
    "db:validate": "turbo -F @cockpit-context/db db:validate",
    "dev:services": "bash scripts/compose.sh -f docker-compose.dev.yml up -d",
    "dev:services:stop": "bash scripts/compose.sh -f docker-compose.dev.yml down",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "dev:tunnel:down": "bash scripts/dev-tunnel.sh down",
    "dev:docker": "bash scripts/dev-docker.sh",
    "dev:docker:logs": "bash scripts/dev-docker-logs.sh",
    "dev:docker:down": "bash scripts/dev-docker-down.sh",
    "find-free-port": "bash scripts/find-free-port.sh",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "env:sync": "tsx scripts/sync-env-example.ts",
    "env:check": "tsx scripts/sync-env-example.ts --check",
    "env:check-entrypoints": "tsx scripts/check-load-dotenv-contract.ts",
    "docker:check-copy": "node --import tsx scripts/check-docker-copy.ts --self-test && node --import tsx scripts/check-docker-copy.ts",
    "deps:check-excludes": "tsx scripts/check-release-age-excludes.ts",
    "docs:check-citations": "tsx scripts/check-doc-citations.ts",
    "policy:prisma-query-casts": "node scripts/check-prisma-query-cast-policy.ts --scan",
    "policy:prisma-query-casts:test": "node scripts/test-prisma-query-cast-policy.ts",
    "policy:checks": "bash scripts/policy-checks.sh",
    "policy:checks:self-test": "bash scripts/policy-checks.sh --self-test",
    "policy:hooks": "node scripts/claude-hooks/pre-tool-use.mjs --self-test && tsx scripts/test-install-claude-hooks.ts",
    "policy:trufflehog-filter": "node scripts/filter-trufflehog-results.mjs --cli-test",
    "policy:template-secrets": "node scripts/check-template-secret-patterns.mjs --self-test && node scripts/check-template-secret-patterns.mjs",
    "policy:local-db-guard": "bash scripts/assert-local-database.sh --self-test",
    "claude:hooks:install": "tsx scripts/install-claude-hooks.ts",
    "policy:theme-contrast": "node --import tsx --test scripts/lib/theme-contrast.test.ts",
    "policy:test-colocation": "node scripts/check-test-colocation.ts",
    "policy:agents-size": "node scripts/check-agents-size.ts",
    "policy:access-matrix": "node scripts/check-access-matrix.ts",
    "policy:access-matrix:self-test": "node scripts/check-access-matrix.ts --self-test",
    "setup": "tsx scripts/setup.ts",
    "test:setup": "node --import tsx --test scripts/lib/admin-email-env.test.ts scripts/lib/smtp-env.test.ts scripts/lib/encryption-keyring-env.test.ts",
    "test:dev-tools": "node --import tsx --test scripts/lib/fake-openrouter.test.ts scripts/lib/e2e-capture.test.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:react": "react-doctor . --offline -y",
    "doctor:react:diff": "react-doctor . --scope changed --base origin/main --offline -y",
    "explore:smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke-explore-agent.ts",
    "explore:eval": "node --env-file-if-exists=.env --import tsx scripts/eval-explore-agent.ts",
    "lsp:smoke": "node --import tsx scripts/smoke-lsp.ts",
    "lsp:build-sandbox": "node scripts/build-landlock-helper.mjs",
    "fake-openrouter": "node --import tsx scripts/fake-openrouter.ts",
    "demo:run": "node --env-file-if-exists=.env --import tsx scripts/demo-run.ts",
    "knip": "knip",
    "knip:production": "knip --production",
    "sync:agent-docs": "tsx scripts/sync-agent-docs.ts",
    "i18n:translate": "tsx scripts/translate-locale-bundles.ts",
    "i18n:translate:mailer": "tsx scripts/translate-locale-bundles.ts --source-dir packages/mailer/src/locales/en-US --target-dir packages/mailer/src/locales/es-MX",
    "postinstall": "lefthook install",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:apply": "node scripts/db/apply.mjs",
    "db:migrate:rebase": "node scripts/db/rebase.mjs",
    "db:reset:local": "node scripts/db/reset-local.mjs",
    "db:worktree": "node scripts/db/worktree.mjs",
    "db:check-migrations": "node scripts/db/check-migrations.mjs",
    "db:test-migrations": "node scripts/db/test-migrations.mjs",
    "db:test-unit": "node --test 'scripts/db/*.test.mjs' 'scripts/db/lib/*.test.mjs'",
    "backup:test-unit": "node --test scripts/backup/*.test.mjs",
    "backup:test": "node scripts/backup/test-backup-restore.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:test-unit": "node --test scripts/deploy-check.test.mjs scripts/build-commit.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@cockpit-context/env": "workspace:*",
    "@cockpit-context/i18n-translate": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@biomejs/biome": "2.6.5",
    "@inquirer/prompts": "^8.7.5",
    "@shadcn/lint": "0.2.5",
    "@cockpit-context/config": "workspace:*",
    "@types/node": "catalog:",
    "knip": "6.44.1",
    "lefthook": "^2.2.2",
    "oxlint": "1.91.0",
    "pg": "catalog:",
    "react-doctor": "0.9.22",
    "tree-sitter-bash": "0.25.1",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-tree-sitter": "0.27.1"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "version": "1.0.0",
  "description": "Self-hosted MCP investigation app that answers coding agents' questions from dependency source at the exact version.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlyCockpit/context.git"
  },
  "homepage": "https://github.com/FlyCockpit/context#readme",
  "bugs": {
    "url": "https://github.com/FlyCockpit/context/issues"
  },
  "author": "FlyCockpit LLC"
}
