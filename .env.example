# =============================================================================
# GENERATED FROM scripts/lib/env-manifest.ts — DO NOT EDIT BY HAND.
# Add or change a variable in that manifest, then run `pnpm env:sync`.
#
# This is the single canonical .env location — loaded by every package.
# Copy to .env and fill in real values: cp .env.example .env
# Do NOT create per-app .env files (e.g. apps/server/.env).
#
# For a PRODUCTION environment, don't fill this in by hand — run
# `pnpm generate:secrets`. It generates the random values, prompts only for
# what it can't know, skips whatever your deploy platform injects, and
# validates the result before printing it.
#
# Shared vs server-only: the env package is split. Shared packages
# (db, mailer, translation, scripts) validate only the [shared] surface —
# DATABASE_URL, NODE_ENV, the BACKUP_* block, SMTP, and the translation
# keys. The server-only vars (BETTER_AUTH_*, CORS_ORIGIN, SSO_*,
# SIGNUP_ENABLED, ADMIN_EMAILS, RATE_LIMIT_*, JOBS_CONCURRENCY,
# SSR_CACHE_TTL_SECONDS) are read only by the app server. You set
# everything in one file regardless. Sections are tagged [shared] or
# [server-only].
#
# Structure: core/required vars first, then optional feature blocks
# (shipped commented out — uncommenting a block is what turns the feature
# on), then one clearly-marked Advanced tuning section of one-off knobs,
# each commented with its working default. The FULL variable catalog —
# including hidden deployment tuning — lives in scripts/lib/env-manifest.ts.
#
# NOTE: There is no auth-bypass mode. To exercise the real signup →
# email-verification → 2FA flow locally, use `pnpm dev:docker` — it ships
# an in-stack mailpit SMTP sink that captures verification email offline
# with zero credentials.
# =============================================================================

# --- Datastores — [shared] -------------------------------------------------

# e.g. postgresql://user:password@host:5432/dbname — or leave blank to omit and set it on the platform
DATABASE_URL=postgresql://postgres:password@localhost:5432/cockpit_context

# --- Runtime + migrations — [shared] ---------------------------------------
# The server applies committed migrations before starting by default.
# For a separate migration job, set MIGRATE_ON_START=false and run the
# image's migrate command before starting the server.

# Read by the image entrypoint. Apply committed migrations before server startup.
# MIGRATE_ON_START=true

# Host HTTP port (1-65535), read only by compose.vps.yaml.
# COCKPIT_CONTEXT_HTTP_PORT=3000

# Set to `production` on every deployed environment. Several env guards
# escalate from a warning to a hard boot failure when this is `production`
# — that is intentional, do not weaken it to silence a startup error.
# Allowed: production | development | test
# NODE_ENV=production

# --- Database backups — [shared] -------------------------------------------
# Verified pg_dump backups are saved to /backups before migrations.
# BACKUP_SCHEDULE=daily also takes a daily dump. Set a private S3 bucket
# for off-site copies and a lifecycle rule to expire old objects.
# Use dedicated backup writer credentials and a separate ListBucket-only
# BACKUP_MONITOR_S3_* identity for the app's freshness check.
# Keep a verified backup and test restore before upgrading.
#
# Disabled by default — uncomment to enable.

# Set daily to take a verified dump every day in addition to pre-migration backups.
# Allowed: off | daily
# BACKUP_SCHEDULE=off

# Enable the app's off-site backup freshness monitoring. This switch does
# not disable the daily or pre-migration dump writer.
# Allowed: true | false
# BACKUP_ENABLED=true

# docker compose only: db-backup starts the S3 backup service. Set it
# once the bucket and dump-writer keys below are filled in (the service
# refuses to start without them and would restart in a loop).
# COMPOSE_PROFILES=db-backup
# Private bucket for pg_dump custom-format dumps. Prefer a dedicated bucket, not the app-assets bucket.
# BACKUP_S3_BUCKET=
# Required for dump writers. Must be a dedicated GetObject/PutObject/AbortMultipartUpload key.
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# ListBucket-only key for the app's freshness check; never reuse the dump read/write key.
# BACKUP_MONITOR_S3_ACCESS_KEY_ID=
# BACKUP_MONITOR_S3_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a real region for AWS S3
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=

# Dumps land under the configured prefix. Scope both keys'
# IAM policies and the bucket lifecycle rules to this prefix.
# BACKUP_S3_PREFIX=cockpit-context/prod/database

# Backup freshness check (app background job, every 6h): alert admins and flag the
# admin dashboard when the newest dump in BACKUP_S3_BUCKET is older than
# this many hours. 36 tolerates one missed nightly run; two always alert.
# BACKUP_MAX_AGE_HOURS=36

# --- Auth — [server-only] --------------------------------------------------

# REQUIRED, minimum 32 characters. The env validator rejects weak and
# placeholder values in production. Rotating this invalidates every
# existing session — generate once per environment and keep it stable.
#
# For LOCAL dev this is filled in for you by `pnpm run setup`; to mint one
# by hand use `pnpm generate:secret` and paste it below. For a PRODUCTION
# environment prefer `pnpm generate:secrets`, which generates this along
# with the rest of the block and validates the result.
BETTER_AUTH_SECRET=
# Origin only — no path, query, hash, or credentials. e.g. https://app.example.com
BETTER_AUTH_URL=https://cockpit-context.localhost

# Optional. Set ONLY when the browser app runs on a different origin than
# the API (raw web dev, split-origin deploys). Leave unset for
# the default same-origin flow. No path, query, or hash.
# CORS_ORIGIN=https://app.example.com

# --- Admin + signup — [server-only] ----------------------------------------

# REQUIRED on first boot. Sign up with a listed address and the one-time
# [bootstrap] token printed to the boot log to become the first admin.
# ADMIN_EMAILS=admin@example.com,other@example.com

# Public account creation is disabled by default. While no account exists,
# an ADMIN_EMAILS address with the boot-log token can create the first admin.
# With SMTP, signup requires email verification. Without SMTP, the app
# boots with a warning and accounts are created verified; password reset
# is unavailable. The signup form remains available.
# SIGNUP_ENABLED=false

# --- Cockpit Context storage + encryption — [server-only] ------------------
# Clones, worktrees and SSH temp files live under COCKPIT_CONTEXT_DATA_DIR (mount a
# volume there). COCKPIT_CONTEXT_ENCRYPTION_KEYS encrypts SSH private keys at rest;
# losing it makes every stored key unreadable, so back it up with the database.

# REQUIRED in production. AES-256-GCM keyring for secrets at rest:
# `v1:<base64 32-byte key>`. To rotate, PREPEND a new version and keep the
# old entries (`v2:<new>,v1:<old>`): the first entry encrypts, all decrypt,
# and rows are re-encrypted lazily. `pnpm run setup` fills a local one;
# `pnpm generate:secrets` mints one for production.
COCKPIT_CONTEXT_ENCRYPTION_KEYS=

# Absolute path for clones and checkouts. Unset: /data in production,
# <repo>/.data in development. A relative path resolves against the repo root.
# COCKPIT_CONTEXT_DATA_DIR=/data

# Disk cap for clones + checkouts, in decimal GB (1 GB = 10^9 bytes). Above it,
# least-recently-used checkouts and then clones are pruned until usage is under
# 90 % of the cap.
# COCKPIT_CONTEXT_MAX_STORAGE_GB=20

# --- Privacy: conversation retention + operator identity — [server-only] ---
# Conversations are deleted automatically this many days after their last
# activity (0 keeps them until deleted). The operator name and contact
# address appear on the public privacy notice; unset, it says no contact
# details have been published.

# Days after its last activity before a conversation, with its runs and
# turns, is deleted (checked daily). 0 keeps conversations until deleted.
# Conversations with a queued or running run are never deleted.
# COCKPIT_CONTEXT_CONVERSATION_RETENTION_DAYS=90

# Person or organization running this instance, shown on the privacy notice.
# COCKPIT_CONTEXT_OPERATOR_NAME=Example Co.

# Address for privacy questions and requests, shown on the privacy notice.
# COCKPIT_CONTEXT_OPERATOR_CONTACT_EMAIL=privacy@example.com

# --- Investigation agent (OpenRouter) — [server-only] ----------------------
# Cockpit Context answers questions with an OpenRouter model. Without OPENROUTER_API_KEY
# the app boots but every investigation fails. Run budgets and concurrency
# caps are in the Advanced tuning section.
#
# Disabled by default — uncomment to enable.

# openrouter.ai → Keys. Also used by `pnpm i18n:translate` when TRANSLATION_PROVIDER=openrouter.
# OPENROUTER_API_KEY=
# e.g. anthropic/claude-sonnet-4.5. Required whenever OPENROUTER_API_KEY is set.
# COCKPIT_CONTEXT_MODEL=
# COCKPIT_CONTEXT_HELPER_MODEL=

# --- Email (SMTP) — [shared] -----------------------------------------------
# Optional. With SMTP set, signup requires email verification and password
# reset works. Without it, accounts are created verified and password reset
# is unavailable.
# Local dev: `pnpm dev:services` starts a mailpit sink and `pnpm run setup`
#   fills these three lines automatically; read captured mail at
#   http://localhost:8025
#
# Disabled by default — uncomment to enable.

# e.g. smtp.resend.com, smtp.postmarkapp.com, email-smtp.us-east-1.amazonaws.com
# SMTP_HOST=localhost
# 587 for STARTTLS (most providers), 465 for implicit TLS, 1025 for a local mailpit sink
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# e.g. "App Name <no-reply@yourdomain.com>". Required whenever SMTP_HOST is set.
# SMTP_FROM=noreply@example.com

# --- SSO / enterprise login — [server-only] --------------------------------
# Optional. FORCE_SSO=true in production requires SSO_ENABLED plus all
# three SSO_CLIENT_ID / SSO_CLIENT_SECRET / SSO_ISSUER values, or the
# server throws at boot.
#
# Disabled by default — uncomment to enable.

# SSO_ENABLED=true
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# e.g. https://your-org.okta.com
# SSO_ISSUER=https://your-org.okta.com
# e.g. "Okta", "Entra ID", "Google Workspace"
# SSO_PROVIDER_NAME=Okta

# --- Translation provider — [shared] ---------------------------------------
# Used by `pnpm i18n:translate`. The openrouter provider reuses
# OPENROUTER_API_KEY from the investigation-agent section.
# The app boots without these; the translator throws on first use if the
# chosen provider's key is missing. Default provider is `openrouter` with
# `anthropic/claude-haiku-4-5`.
#
# Disabled by default — uncomment to enable.

# Allowed: openrouter | anthropic
# TRANSLATION_PROVIDER=openrouter
# Required when TRANSLATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Advanced tuning -------------------------------------------------------
# One-off tuning knobs, grouped by feature. Every value has a working
# default shown on its line — uncomment and change ONLY the one you need.
# Rate-limit budgets rescale their whole limiter family coherently
# (multiplier = provided / reference). Deeper deployment knobs are
# deliberately absent from this file;
# the full catalog lives in scripts/lib/env-manifest.ts.

# === Datastores — [shared] ===

# Max connections in this process's Postgres pool (node-postgres `max`).
# Default 10 matches the driver default — raise it only against the
# database's connection budget; the app and each standalone script hold their own pool.
# DATABASE_POOL_MAX=10

# === Runtime + migrations — [shared] ===

# [server-only] Background jobs the in-process runner executes at once
# The runner lives in the app process;
# there is no separate worker.
# JOBS_CONCURRENCY=2

# === Auth — [server-only] ===

# Number of reverse-proxy hops in front of the app, for deriving the real
# client IP used as the anonymous rate-limit key. LEAVE UNSET — the default
# auto-detects a client behind a private-network proxy (e.g. Dokploy/nginx)
# and keys on the socket peer otherwise. Set it only
# when a proxy in front of the app has a PUBLIC IP (e.g. Cloudflare): the
# exact hop count. 0 disables X-Forwarded-For entirely.
# TRUST_PROXY_HOPS=1

# === Cockpit Context storage + encryption — [server-only] ===

# Exact host names (comma-separated; no wildcards, ports or IPs) of internal git servers whose remotes may resolve to RFC 1918, CGNAT or IPv6 unique-local addresses. Loopback, link-local and cloud-metadata addresses stay refused. An SSRF trade-off: see docs/deploy.md.
# COCKPIT_CONTEXT_GIT_HOST_ALLOWLIST=
# A branch or default-ref question fetches the remote only when the last fetch is older than this. Tags and commits never refetch once present.
# COCKPIT_CONTEXT_FETCH_INTERVAL_SECONDS=300

# === Investigation agent (OpenRouter) — [server-only] ===

# The API the agent speaks to the model endpoint: chat-completions (OpenAI Chat
# Completions), responses (OpenAI Responses) or messages (Anthropic Messages).
# OpenRouter serves all three, with prompt caching on each. The local fake
# OpenRouter server speaks chat-completions only.
# COCKPIT_CONTEXT_MODEL_API=chat-completions

# API root ending in /v1; leave unset to use OpenRouter (https://openrouter.ai/api/v1).
# Set it for the local fake OpenRouter server or an OpenRouter-compatible gateway.
# Production refuses a non-https value.
# COCKPIT_CONTEXT_OPENROUTER_BASE_URL=http://localhost:4010/api/v1
# Agent-loop iteration cap per main run; helper budgets scale from it.
# COCKPIT_CONTEXT_MAX_ITERATIONS=100
# Wall-clock cap per run (and the checkout-lease length). The agent writes a final summary when it runs out.
# COCKPIT_CONTEXT_RUN_TIMEOUT_SECONDS=600
# Longest a model request may send nothing. Before the first token it is retried, then failed over; mid-answer the dispatch fails. 10 to 3600.
# COCKPIT_CONTEXT_MODEL_STALL_SECONDS=90
# Runs executing at once across all users; the rest queue in order.
# COCKPIT_CONTEXT_MAX_CONCURRENT_RUNS=4
# Runs executing at once for one user. Overview summary runs do not count (they count toward the global cap only).
# COCKPIT_CONTEXT_MAX_CONCURRENT_RUNS_PER_USER=3
# Longest an MCP query_dependency/get_query_result call waits before returning `running`; also the cap on the caller's wait_seconds.
# COCKPIT_CONTEXT_MCP_WAIT_SECONDS=900
# query_dependency calls one MCP credential (token or OAuth connection) may make per hour; each starts a model-spending run.
# COCKPIT_CONTEXT_MCP_QUERIES_PER_HOUR=30
# Cap on query_dependency calls per hour for one USER across all of their MCP tokens and OAuth connections (default 120). 0 = unlimited: only the per-credential COCKPIT_CONTEXT_MCP_QUERIES_PER_HOUR applies.
# COCKPIT_CONTEXT_MCP_QUERIES_PER_USER_PER_HOUR=120

# MCP tool calls of any kind one credential may make per minute.
# Every other Cockpit Context rate budget is a COCKPIT_CONTEXT_<WHAT>_PER_<WINDOW> count
# (at least 1; no budget can be turned off). They are listed in
# Admin -> Settings.
# COCKPIT_CONTEXT_MCP_TOOL_CALLS_PER_MINUTE=120
# Language servers stop after this much idle time.
# COCKPIT_CONTEXT_LSP_IDLE_SECONDS=30
# Language servers running at once; the least recently used is evicted. 0 disables the LSP tools.
# COCKPIT_CONTEXT_LSP_MAX_SERVERS=4
# required: language servers run in a Landlock sandbox that can read only the checkout and their own files (Linux 5.13+ with Landlock enabled; the image ships the helper), and without it the LSP tools are disabled. off: run them unsandboxed (development hosts only; logs a warning).
# COCKPIT_CONTEXT_LSP_SANDBOX=required

# === SSO / enterprise login — [server-only] ===

# true disables password login entirely. In production this requires
# SSO_ENABLED plus all three SSO credentials or the server throws at boot.
# FORCE_SSO=false

# === Rate limiting — [server-only] ===
# Three named budgets (AUTH, RPC, EMAIL), two knobs
# each. Each budget describes its family's reference member; every other
# limiter in the family scales with it at its designed ratio, so setting
# a budget re-tunes the whole family coherently. Defaults are sensible;
# tighter is not safer — if a surface 429s legitimate users, split the
# surface instead of shrinking a budget.

# Auth family reference: requests per IP per window on the general /api/auth/* surface (password reset, verification, session ops). Setting it rescales the whole fail-closed auth family at each member's designed ratio: credential 10, credential-burst 3/10s, signup 10/h, 2FA-OTP 3/15min.
# RATE_LIMIT_AUTH_POINTS=30
# Window (seconds) for the auth family reference. Scales every auth-family window AND block duration by the same factor.
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RPC family reference: requests per user (per IP signed out) per window on /rpc/*. /ready (60) and the SSR catch-all (300) scale with it. One batched request can carry up to ORPC_BATCH_MAX_SIZE procedures.
# RATE_LIMIT_RPC_POINTS=100
# Window (seconds) for the RPC family reference; scales /ready and SSR with it.
# RATE_LIMIT_RPC_WINDOW_SECONDS=60
# Email family reference: mails per RECIPIENT per window on the anonymous send-mail endpoints (verification resend, password reset). Signup (6) and sign-in-triggered mails (10) scale with it. Keyed on the mailbox, so rotating IPs cannot flood one inbox. 0 disables the whole recipient family.
# RATE_LIMIT_EMAIL_POINTS=3
# Window (seconds) for the email family reference; scales all three recipient buckets with it.
# RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600

# === Cache limits — [server-only] ===
# Optional tuning. Sensible defaults are built in.

# In-memory SSR HTML cache for anonymous GETs of public routes. 0 disables
# it. Public content edits can take up to this long to appear live.
# SSR_CACHE_TTL_SECONDS=60
