// Conversations, agent runs and their saved turns — docs/product.md.
//
// Only the owner ever reads these; admins included. Every query is scoped by
// `ownerId` (AgentRun carries its own copy so the per-user concurrency count
// and ownership checks need no join).

enum ConversationOrigin {
  MCP
  WEB
}

/// One thread with the investigation agent about one package checkout.
model Conversation {
  id                 String             @id @default(cuid(2))
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  ownerId            String
  Owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// SetNull on package delete; `packageIdentifier` keeps the snapshot.
  packageId          String?
  Package            Package?           @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageIdentifier  String
  /// What the caller asked for (at most one of the two).
  requestedVersion   String?
  requestedRef       String?
  /// SetNull when the checkout is pruned; follow-up chat re-creates it from
  /// `commitSha`.
  checkoutId         String?
  Checkout           Checkout?          @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  /// Resolution snapshots. Null until the version resolved.
  commitSha          String?
  resolvedFrom       String?
  origin             ConversationOrigin
  /// The MCP connection that started it (at most one; SetNull on delete).
  mcpAgentTokenId    String?
  McpAgentToken      McpAgentToken?     @relation(fields: [mcpAgentTokenId], references: [id], onDelete: SetNull)
  mcpGrantId         String?
  McpGrant           McpGrant?          @relation(fields: [mcpGrantId], references: [id], onDelete: SetNull)
  /// Snapshot of the token name or OAuth client name. Null for WEB.
  mcpConnectionLabel String?
  title              String
  lastActivityAt     DateTime           @default(now())

  AgentRuns AgentRun[]
  Pins      ConversationPin[]

  @@index([ownerId, lastActivityAt])
  @@index([ownerId, packageId, lastActivityAt])
  @@index([ownerId, origin, lastActivityAt])
  @@index([packageId])
  @@index([checkoutId])
  @@index([mcpAgentTokenId])
  @@index([mcpGrantId])
  @@map("conversation")
}

/// A conversation its owner pinned to the home, in the owner's order
/// (docs/product.md). Only the conversation's owner pins it, and reads join
/// on `Conversation.ownerId = userId` too, so a pin never shows a
/// conversation its user cannot see. Gone with the user or the conversation.
model ConversationPin {
  id             String       @id @default(cuid(2))
  createdAt      DateTime     @default(now())
  userId         String
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Ascending order on the home: a new pin goes last, `pins.reorder` renumbers from 0.
  position       Int

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@map("conversation_pin")
}

/// MAIN runs answer the user; HELPER runs are `delegate_explore` children of a
/// main run; SUMMARY runs write a checkout's overview and have no conversation.
enum AgentRunKind {
  MAIN
  HELPER
  SUMMARY
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  STOPPED
  INTERRUPTED
}

enum AgentRunTrigger {
  MCP_QUERY
  WEB_MESSAGE
  SUMMARY
}

/// One execution of the agent loop.
model AgentRun {
  id                String          @id @default(cuid(2))
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  ownerId           String
  Owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Null only for SUMMARY runs.
  conversationId    String?
  Conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Set on HELPER runs: the main run that delegated them.
  parentRunId       String?
  ParentRun         AgentRun?       @relation("AgentRunHelpers", fields: [parentRunId], references: [id], onDelete: Cascade)
  /// The checkout this run reads (the summary target for SUMMARY runs).
  /// SetNull when pruned.
  checkoutId        String?
  Checkout          Checkout?       @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  kind              AgentRunKind
  status            AgentRunStatus  @default(QUEUED)
  trigger           AgentRunTrigger
  /// The model id the run used (COCKPIT_CONTEXT_MODEL or COCKPIT_CONTEXT_HELPER_MODEL at start).
  model             String?
  /// HELPER runs: the focus the main agent delegated.
  focus             String?
  /// HELPER runs: 0-based, the position of its brief among every brief its main
  /// run delegated, in call order (the transcript orders and numbers helper
  /// panels by it; parallel helpers share a createdAt).
  helperIndex       Int?
  /// The agent loop's stop reason (`completed`, `max-iterations`, `timeout`, …).
  stopReason        String?
  error             String?
  /// Client-safe detail of a run that failed before the agent started (the
  /// version did not resolve): `{ reason, nearestTags?, host?, port? }`, an
  /// allowlisted RepoError projection. Unlike `error`, shown to the owner.
  failure           Json?
  inputTokens       Int             @default(0)
  outputTokens      Int             @default(0)
  cachedInputTokens Int             @default(0)
  /// Cost in millionths of a US dollar. Never a float. Only the priced
  /// dispatches: a lower bound when `unpricedCalls` > 0.
  costUsdMicros     Int             @default(0)
  /// Model dispatches whose provider reported no cost. Any at all makes the
  /// run's cost unknown (MCP reports `priced: false`), never $0.
  unpricedCalls     Int             @default(0)
  /// The provider's id for every answered model call of this run, in order
  /// (OpenRouter: `GET /api/v1/generation?id=` gives each call's billed cost),
  /// so `costUsdMicros` can be checked call by call. Never shown to users.
  generationIds     String[]        @default([])
  iterations        Int             @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  /// Final assistant text (MAIN and SUMMARY runs).
  answer            String?
  /// When `conversations.retry` asked this MAIN run's question again (it had
  /// ended without an answer). Such a run stays in the transcript but is left
  /// out of every later run's history.
  retriedAt         DateTime?

  HelperRuns AgentRun[]      @relation("AgentRunHelpers")
  Turns      RunTurn[]
  Leases     CheckoutLease[]

  @@index([conversationId, createdAt])
  @@index([parentRunId])
  @@index([checkoutId])
  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("agent_run")
}

enum RunTurnRole {
  USER
  ASSISTANT
  TOOL
}

/// One saved message of a run, written as the loop finishes it.
model RunTurn {
  id        String      @id @default(cuid(2))
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  runId     String
  AgentRun  AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 0-based order within the run.
  seq       Int
  role      RunTurnRole
  /// Message parts in `@cockpit-context/agent-runtime`'s AgentMessage part shape.
  parts     Json
  /// A USER turn the owner sent while the run was live (steering).
  steering  Boolean     @default(false)

  @@unique([runId, seq])
  @@map("run_turn")
}
